@namespace EcoMeal.Client.Components.SearchDropdown
@using EcoMeal.Client.Components.SearchResultCard

<div class="search-dropdown-wrapper">
    <MudPaper Elevation="0" Class="search-shell d-flex align-center">
        <MudIcon Icon="@Icons.Material.Outlined.Search" Style="color: var(--accent); font-size: 1.25rem; margin-right: 0.5rem;" />
        <input type="text" class="search-input" placeholder="Search businesses and packages"
               value="@_searchText" @oninput="OnInput" @onfocus="HandleFocus" @onkeydown="HandleKeyDown" />
    </MudPaper>

    @if (_isOpen)
    {
        <div class="search-backdrop" @onclick="Close"></div>
        <div class="search-results-dropdown">
            @if (_loading)
            {
                <div class="search-status">
                    <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Color="Color.Success" />
                    <span>Searching…</span>
                </div>
            }
            else if (FilteredResults.Any())
            {
                @foreach (var result in FilteredResults)
                {
                    <SearchResultCard Result="result" OnClick="() => Navigate(result.NavigateUrl)" />
                }
            }
            else
            {
                <div class="search-status">No results found</div>
            }
        </div>
    }
</div>
