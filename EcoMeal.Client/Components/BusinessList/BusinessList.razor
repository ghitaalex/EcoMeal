@namespace EcoMeal.Client.Components.BusinessList
@using EcoMeal.Client.Components.BusinessCard
@using EcoMeal.Client.Models

@if (_loadError is not null)
{
    <div class="api-error" role="alert">
        <span class="api-error-icon"><MudIcon Icon="@Icons.Material.Outlined.CloudOff" /></span>
        <div class="api-error-copy">
            <span class="section-kicker">Connection unavailable</span>
            <h2>We couldn't load nearby food</h2>
            <p>@_loadError Start <code>EcoMeal.Api</code>, then try again.</p>
        </div>
        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Class="retry-btn"
                   Disabled="@_isRetrying"
                   OnClick="LoadBusinesses">
            @(_isRetrying ? "Trying…" : "Try again")
        </MudButton>
    </div>
}
else if (Businesses is null)
{
    <div class="business-loading" aria-label="Loading businesses">
        <div class="loading-heading"></div>
        <div class="loading-grid">
            @for (var i = 0; i < 6; i++)
            {
                <div class="loading-card"></div>
            }
        </div>
    </div>
}
else
{
    <div class="filter-row" aria-label="Filter businesses by category">
        <span class="filter-count">
            @FilteredBusinesses.Count() business@(FilteredBusinesses.Count() == 1 ? "" : "es") available
        </span>
        <div class="filter-scroll">
            <button type="button" class="category-filter @(_selectedType is null ? "active" : null)"
                    aria-pressed="@(_selectedType is null)" @onclick="() => SelectFilter(null)">
                <span class="category-icon"><MudIcon Icon="@Icons.Material.Filled.AllInclusive" /></span>
                <span>All</span>
            </button>
            @foreach (var type in BusinessTypes)
            {
                <button type="button" class="category-filter @(_selectedType == type ? "active" : null)"
                        aria-pressed="@(_selectedType == type)" @onclick="() => SelectFilter(type)">
                    <span class="category-icon"><MudIcon Icon="@GetIconForType(type)" /></span>
                    <span>@type</span>
                </button>
            }
        </div>
    </div>

    <div class="discover-header">
        <div>
            <span class="section-kicker">Fresh finds near you</span>
            <h2>Discover something delicious</h2>
        </div>
        <AuthorizeView Roles="Admin">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Class="add-business-btn" Href="/business/add">
                Add business
            </MudButton>
        </AuthorizeView>
    </div>

    <div class="discovery-controls">
        <div class="location-control">
            @if (_userLocation is not null)
            {
                <span class="location-icon location-active"><MudIcon Icon="@Icons.Material.Filled.MyLocation" /></span>
                <div>
                    <strong>Using your location</strong>
                </div>
                <button type="button" class="location-refresh" @onclick="RequestLocationAsync" aria-label="Refresh your location">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            }
            else
            {
                <span class="location-icon"><MudIcon Icon="@Icons.Material.Outlined.LocationOn" /></span>
                <div>
                    <strong>@(_isLocating ? "Finding your location…" : "See what's closest")</strong>
                    <span>Allow location access to calculate distance.</span>
                </div>
                <button type="button" class="location-button" @onclick="RequestLocationAsync" disabled="@_isLocating">
                    @(_isLocating ? "Locating…" : "Use my location")
                </button>
            }
        </div>

        <div class="view-toggle" aria-label="Choose business view">
            <button type="button" class="@(_viewMode == "list" ? "active" : null)" @onclick="@(() => SetViewMode("list"))">
                <i class="bi bi-grid"></i><span>List</span>
            </button>
            <button type="button" class="@(_viewMode == "map" ? "active" : null)" @onclick="@(() => SetViewMode("map"))">
                <i class="bi bi-map"></i><span>Map</span>
            </button>
        </div>
    </div>

    @if (_locationError is not null)
    {
        <div class="location-message" role="status">
            <MudIcon Icon="@Icons.Material.Outlined.LocationDisabled" />
            <span>@_locationError</span>
        </div>
    }

    @if (_viewMode == "map")
    {
        <div class="map-shell">
            @if (_mapError is not null)
            {
                <div class="map-message" role="alert">
                    <MudIcon Icon="@Icons.Material.Outlined.Map" />
                    <p>@_mapError</p>
                    <button type="button" @onclick="@(() => SetViewMode("map"))">Try again</button>
                </div>
            }
            else
            {
                <div id="@_mapElementId" class="business-map" aria-label="Map of EcoMeal businesses"></div>
                @if (!MappableBusinesses.Any())
                {
                    <div class="map-coordinate-notice">
                        Business locations are being prepared. Refresh shortly to see their markers.
                    </div>
                }
            }
        </div>
    }
    else if (!FilteredBusinesses.Any())
    {
        <div class="empty-results">
            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" />
            <h3>No places in this category yet</h3>
            <p>Try another filter to discover more food nearby.</p>
        </div>
    }
    else
    {
        <div class="business-grid">
            @foreach (BusinessModel business in FilteredBusinesses)
            {
                <BusinessCard Business="business" />
            }
        </div>
    }
}
