@namespace EcoMeal.Client.Components.BusinessCard
@using Microsoft.AspNetCore.Components.Authorization

@if (!_deleted)
{
<div class="business-card" @onclick="NavigateToDetails">
    <div class="card-hero" style="@(string.IsNullOrEmpty(Business.BusinessImageUrl) ? "background: linear-gradient(135deg, #0B0F19 0%, #047857 100%);" : $"background: url('{Business.BusinessImageUrl}') center/cover no-repeat;")">
        <div class="card-hero-overlay"></div>
        <div class="card-hero-content">
            <span class="business-type-badge">@Business.BusinessTypeName</span>
            <h5 class="business-name">@Business.Name</h5>
            @if (!string.IsNullOrEmpty(Business.Description))
            {
                <p class="business-description">@Business.Description</p>
            }
            <div class="hero-details">
                <span class="hero-chip"><i class="bi bi-geo-alt-fill"></i> @Business.Address</span>
                <span class="hero-chip"><i class="bi bi-envelope-fill"></i> @Business.Contact</span>
            </div>
        </div>
    </div>
    <div class="card-content">
        @if (_lowestPrice.HasValue)
        {
            <div class="card-package-info">
                <div class="package-info-item">
                    <i class="bi bi-tag-fill"></i>
                    <span>From @_lowestPrice.Value.ToString("C")</span>
                </div>
                @if (_earliestPickup is not null)
                {
                    <div class="package-info-item">
                        <i class="bi bi-clock-fill"></i>
                        <span>Pickup from @_earliestPickup</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="no-packages-text"><i class="bi bi-box-seam"></i> No packages yet — check again later</p>
        }
        <AuthorizeView Roles="Admin">
            <div class="card-actions">
                <button type="button" class="btn-edit" @onclick="NavigateToEdit" @onclick:stopPropagation="true">
                    <i class="bi bi-pencil"></i> Edit
                </button>
                <button type="button" class="btn-delete" @onclick="HandleDelete" @onclick:stopPropagation="true">
                    <i class="bi bi-trash3"></i> Remove
                </button>
            </div>
        </AuthorizeView>
    </div>
</div>
}