@namespace EcoMeal.Client.Components.BusinessCard
@using Microsoft.AspNetCore.Components.Authorization

@if (!_deleted)
{
<div class="business-card" @onclick="NavigateToDetails">
    <div class="card-hero" style="@(string.IsNullOrEmpty(Business.BusinessImageUrl) ? "background: var(--gradient-default);" : $"background: url('{Business.BusinessImageUrl}') center/cover no-repeat;")">
        <div class="card-hero-overlay"></div>
        <span class="business-type-badge">@Business.BusinessTypeName</span>
        <AuthorizeView>
            <button type="button"
                    class="favorite-button @(Business.IsFavorite ? "active" : null)"
                    title="@(Business.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                    aria-label="@(Business.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                    disabled="@_updatingFavorite"
                    @onclick="ToggleFavorite"
                    @onclick:stopPropagation="true">
                @if (_updatingFavorite)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi @(Business.IsFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                }
            </button>
        </AuthorizeView>
        <span class="rating-badge"><i class="bi bi-star-fill"></i> @Business.AverageRating.ToString("0.0") (@Business.ReviewCount)</span>
    </div>
    <div class="card-content">
        <div class="card-title-row">
            <h5 class="business-name">@Business.Name</h5>
            @if (Business.DistanceKm.HasValue)
            {
                <span class="distance-chip"><i class="bi bi-navigation-fill"></i> @FormattedDistance</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Business.Description))
        {
            <p class="business-description">@Business.Description</p>
        }
        <p class="business-address"><i class="bi bi-geo-alt"></i><span>@Business.Address</span></p>
        @if (_lowestPrice.HasValue)
        {
            <div class="card-package-info">
                <div class="package-info-item">
                    <i class="bi bi-tag-fill"></i>
                    <span>From @_lowestPrice.Value.ToString("0.00") RON</span>
                </div>
                @if (_earliestPickup is not null)
                {
                    <div class="package-info-item">
                        <i class="bi bi-clock-fill"></i>
                        <span>Pickup from @_earliestPickup</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="no-packages-text"><i class="bi bi-box-seam"></i> No packages available yet</p>
        }
        <AuthorizeView Roles="Admin">
            <div class="card-actions">
                <button type="button" class="btn-edit" @onclick="NavigateToEdit" @onclick:stopPropagation="true">
                    <i class="bi bi-pencil"></i> Edit
                </button>
                <button type="button" class="btn-delete" @onclick="HandleDelete" @onclick:stopPropagation="true" disabled="@_deleting">
                    @if (_deleting)
                    {
                        <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Style="width: 14px; height: 14px; color: inherit;" />
                        <span>Deleting…</span>
                    }
                    else
                    {
                        <i class="bi bi-trash3"></i>
                        <span>Remove</span>
                    }
                </button>
            </div>
        </AuthorizeView>
    </div>
</div>

<MudMessageBox @ref="_deleteConfirmBox" Title="Delete Business" YesText="Delete" CancelText="Cancel">
    <MessageContent>
        <MudText Typo="Typo.body1">
            Are you sure you want to delete <b>@Business.Name</b>? This action cannot be undone.
        </MudText>
    </MessageContent>
</MudMessageBox>
}
