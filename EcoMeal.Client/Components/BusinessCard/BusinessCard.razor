@namespace EcoMeal.Client.Components.BusinessCard

@if (!_deleted)
{
<div class="card shadow-sm h-100" @onclick="NavigateToDetails">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start mb-2">
            <h5 class="card-title mb-0">@Business.Name</h5>
            <span class="badge bg-secondary">@Business.BusinessTypeName</span>
        </div>
        @if (!string.IsNullOrEmpty(Business.Description))
        {
            <p class="card-text text-muted mb-2">@Business.Description</p>
        }
        <div class="mt-auto">
            <p class="card-text mb-1"><small><i class="bi bi-geo-alt"></i> @Business.Address</small></p>
            <p class="card-text mb-3"><small><i class="bi bi-envelope-at"></i> @Business.Contact</small></p>
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="HandleDelete">
                Delete
            </button>
        </div>
    </div>
</div>
}