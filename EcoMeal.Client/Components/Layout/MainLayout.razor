@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="6" Fixed="true" Style="background-color: white; color: black;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudButton Href="/" Variant="Variant.Text" Style="text-transform: none; color: black; font-size: 1.25rem;"><span>Eco</span><span style="font-weight: bold;">Meal</span></MudButton>
        <MudSpacer />
        @if (_isHomePage)
        {
            <MudPaper Elevation="0" Class="d-flex align-center" Style="border: 1px solid #e0e0e0; border-radius: 50px; padding: 0.2rem 0.75rem; max-width: 400px; width: 100%; background: #f5f5f5;">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Style="color: #9e9e9e; font-size: 1.25rem; margin-right: 0.5rem;" />
                <MudTextField @bind-Value="_searchText" Immediate="true" Placeholder="Search businesses..."
                              Variant="Variant.Text" Margin="Margin.Dense"
                              Style="flex: 1; font-size: 0.9rem;" DisableUnderLine="true" />
            </MudPaper>
            <MudSpacer />
        }
        <MudIconButton Icon="@Icons.Material.Outlined.ShoppingCart" Color="Color.Inherit" />
        <MudIconButton Icon="@Icons.Material.Outlined.AccountCircle" Color="Color.Inherit" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pa-4" Style="margin-top: 48px;">
        <CascadingValue Value="_searchText" Name="SearchText">
            @Body
        </CascadingValue>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private string _searchText = string.Empty;
    private bool _isHomePage;

    protected override void OnInitialized()
    {
        _isHomePage = IsHome();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _isHomePage = IsHome();
        _searchText = string.Empty;
        InvokeAsync(StateHasChanged);
    }

    private bool IsHome() =>
        new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/') is "" or "/";

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
