@using EcoMeal.Client.Services
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject IJSRuntime JS
<MudThemeProvider Theme="_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@($"eco-layout {(_isDarkMode ? "theme-dark" : "theme-light")}")">
    <MudAppBar Elevation="0" Fixed="true" Class="main-appbar">
        <div class="appbar-row">
            <div class="appbar-brand-group">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Open navigation" Class="nav-trigger" />
                <MudButton Href="/" Variant="Variant.Text" Class="brand-btn">
                    <span class="brand-mark"><MudIcon Icon="@Icons.Material.Filled.EnergySavingsLeaf" /></span>
                    <span class="brand-text"><span>Eco</span><strong>Meal</strong></span>
                </MudButton>
            </div>
            <div class="navbar-search">
                <SearchDropdown />
            </div>
            <div class="appbar-actions">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit" OnClick="ToggleTheme" aria-label="Toggle color theme" Class="header-action" />
                <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart" Color="Color.Inherit" Href="/orders" aria-label="My orders" Class="header-action" />
        @if (AuthService.IsAuthenticated)
        {
            <MudMenu Icon="@Icons.Material.Filled.Person" Color="Color.Success" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     Class="profile-menu-btn">
                <ChildContent>
                    <div style="padding: 1rem 1.25rem 0.75rem; text-align: center; min-width: 200px;">
                        <MudAvatar Color="Color.Success" Size="Size.Large" Style="margin: 0 auto 0.5rem; background: var(--gradient-primary);">
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@(AuthService.UserName ?? "User")</MudText>
                        <MudText Typo="Typo.caption" Style="color: var(--text-dim);">Welcome back!</MudText>
                    </div>
                    <MudDivider Style="border-color: var(--border-color);" />
                    <MudMenuItem Href="/profile" Icon="@Icons.Material.Outlined.AccountCircle" IconColor="Color.Success">Profile</MudMenuItem>
                    <MudMenuItem OnClick="HandleLogout" Icon="@Icons.Material.Outlined.Logout" IconColor="Color.Error" Style="color: #EF4444;">Logout</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <MudButton Href="/login" Variant="Variant.Filled" Size="Size.Small" Class="login-btn">
                <span class="login-label">Log in</span>
            </MudButton>
        }
            </div>
        </div>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Temporary" Width="280px" Class="main-drawer">
        <div class="drawer-heading">
            <span class="brand-mark"><MudIcon Icon="@Icons.Material.Filled.EnergySavingsLeaf" /></span>
            <div><strong>EcoMeal</strong><small>Good food, rescued.</small></div>
        </div>
        <NavMenu />
        <div class="drawer-note">
            <MudIcon Icon="@Icons.Material.Filled.EnergySavingsLeaf" />
            <span>Every rescued meal makes a difference.</span>
        </div>
    </MudDrawer>
    <MudMainContent Class="app-main">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private bool _isDarkMode = false;

    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Black = "#1E293B",
            Background = "#F8FAFC",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            TextPrimary = "#1E293B",
            TextSecondary = "#64748B",
            TextDisabled = "#94A3B8",
            ActionDefault = "#64748B",
            Primary = "#3f9e71",
            Secondary = "#3f9e71",
            Success = "#3f9e71",
            Info = "#3f9e71",
            LinesDefault = "#E2E8F0",
            LinesInputs = "#CBD5E1",
            Divider = "#E2E8F0",
            DividerLight = "#F1F5F9",
        },
        PaletteDark = new PaletteDark()
        {
            Black = "#0B0F19",
            Background = "#0B0F19",
            Surface = "#141A2A",
            DrawerBackground = "#111827",
            AppbarBackground = "#111827",
            TextPrimary = "#F1F5F9",
            TextSecondary = "#94A3B8",
            TextDisabled = "#64748B",
            ActionDefault = "#94A3B8",
            Primary = "#3f9e71",
            Secondary = "#3f9e71",
            Success = "#3f9e71",
            Info = "#3f9e71",
            LinesDefault = "#193f2d",
            LinesInputs = "#193f2d",
            Divider = "#193f2d",
            DividerLight = "#193f2d",
        }
    };

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", "theme", _isDarkMode ? "dark" : "light");
        await JS.InvokeVoidAsync("eval", $"document.documentElement.className = '{(_isDarkMode ? "theme-dark" : "theme-light")}'");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.LoadTokenAsync();
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", "theme");
            _isDarkMode = stored == "dark";
            await JS.InvokeVoidAsync("eval", $"document.documentElement.className = '{(_isDarkMode ? "theme-dark" : "theme-light")}'");
            StateHasChanged();
        }
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}
