@using EcoMeal.Client.Services
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@implements IDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Fixed="true" Style="background: #111827; color: #F1F5F9; border-bottom: 1px solid #1E3A2F;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudButton Href="/" Variant="Variant.Text" Style="text-transform: none; color: #F1F5F9; font-size: 1.25rem; font-family: 'Inter', sans-serif;">
            <MudIcon Icon="@Icons.Material.Filled.EnergySavingsLeaf" Style="color: #059669; margin-right: 0.25rem;" />
            <span style="font-weight: 300;">Eco</span><span style="font-weight: 800; color: #34D399;">Meal</span>
        </MudButton>
        <MudSpacer />
        @if (_isHomePage)
        {
            <MudPaper Elevation="0" Class="d-flex align-center" Style="border: 1.5px solid #1E3A2F; border-radius: 50px; padding: 0.2rem 0.75rem; max-width: 400px; width: 100%; background: #141A2A;">
                <MudIcon Icon="@Icons.Material.Outlined.Search" Style="color: #059669; font-size: 1.25rem; margin-right: 0.5rem;" />
                <MudTextField @bind-Value="_searchText" Immediate="true" Placeholder="Search businesses..."
                              Variant="Variant.Text" Margin="Margin.Dense"
                              Style="flex: 1; font-size: 0.9rem; color: #F1F5F9;" DisableUnderLine="true" />
            </MudPaper>
            <MudSpacer />
        }
        <MudIconButton Icon="@Icons.Material.Outlined.ShoppingCart" Color="Color.Inherit" />
        @if (AuthService.IsAuthenticated)
        {
            <MudMenu Icon="@Icons.Material.Filled.Person" Color="Color.Success" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                     Class="profile-menu-btn">
                <ChildContent>
                    <div style="padding: 1rem 1.25rem 0.75rem; text-align: center; min-width: 200px;">
                        <MudAvatar Color="Color.Success" Size="Size.Large" Style="margin: 0 auto 0.5rem; background: linear-gradient(135deg, #059669, #34D399);">
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                        </MudAvatar>
                        <MudText Typo="Typo.subtitle1" Style="color: #F1F5F9; font-weight: 600;">@(AuthService.UserName ?? "User")</MudText>
                        <MudText Typo="Typo.caption" Style="color: #64748B;">Welcome back!</MudText>
                    </div>
                    <MudDivider Style="border-color: #1E3A2F;" />
                    <MudMenuItem OnClick="HandleLogout" Icon="@Icons.Material.Outlined.Logout" IconColor="Color.Error" Style="color: #FCA5A5;">Logout</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <MudButton Href="/login" Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Login" Style="text-transform: none;">
                Log In
            </MudButton>
        }
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Always" Style="background: #111827; border-right: 1px solid #1E3A2F;">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pa-4" Style="margin-top: 48px; background: #0B0F19; min-height: 100vh;">
        <CascadingValue Value="_searchText" Name="SearchText">
            @Body
        </CascadingValue>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = false;
    private string _searchText = string.Empty;
    private bool _isHomePage;

    private MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark()
        {
            Black = "#0B0F19",
            Background = "#0B0F19",
            Surface = "#141A2A",
            DrawerBackground = "#111827",
            AppbarBackground = "#111827",
            TextPrimary = "#F1F5F9",
            TextSecondary = "#94A3B8",
            TextDisabled = "#64748B",
            ActionDefault = "#94A3B8",
            Primary = "#059669",
            Secondary = "#047857",
            Success = "#059669",
            Info = "#059669",
            LinesDefault = "#1E3A2F",
            LinesInputs = "#1E3A2F",
            Divider = "#1E3A2F",
            DividerLight = "#1E3A2F",
        }
    };

    protected override void OnInitialized()
    {
        _isHomePage = IsHome();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _isHomePage = IsHome();
        _searchText = string.Empty;
        InvokeAsync(StateHasChanged);
    }

    private bool IsHome() =>
        new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/') is "" or "/";

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (firstRender)
    {
        await AuthService.LoadTokenAsync();
        StateHasChanged();
    }
}

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/", forceLoad: true);
}
}
