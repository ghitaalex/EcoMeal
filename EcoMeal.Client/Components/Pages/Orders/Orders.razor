@page "/orders"

<PageTitle>My Orders | EcoMeal</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4" Style="font-weight: 700; color: var(--text-primary);">My Orders</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--text-dim);">Track and manage your food rescue orders</MudText>
        </MudStack>
        @if (MyOrders is not null && MyOrders.Any())
        {
            <MudChip T="string" Size="MudBlazor.Size.Medium" Variant="Variant.Filled"
                     Style="background: var(--chip-bg); color: var(--accent-light); font-weight: 600;">
                @MyOrders.Count order@(MyOrders.Count != 1 ? "s" : "")
            </MudChip>
        }
    </MudStack>

    @if (MyOrders is null)
    {
        <MudStack Spacing="3">
            @for (int i = 0; i < 3; i++)
            {
                <MudPaper Class="pa-6 rounded-xl" Style="background: var(--bg-surface); border: 1px solid var(--border-color);" Elevation="0">
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="40%" Height="24px" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" Height="18px" Class="mt-2" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" Width="25%" Height="18px" Class="mt-2" />
                </MudPaper>
            }
        </MudStack>
    }
    else if (!MyOrders.Any())
    {
        <MudPaper Class="pa-12 rounded-xl d-flex flex-column align-center justify-center" Style="border: 2px dashed var(--border-color); background: var(--bg-surface);" Elevation="0">
            <MudIcon Icon="@Icons.Material.Outlined.ShoppingBag" Style="font-size: 4rem; color: var(--accent);" />
            <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--text-secondary); font-weight: 600;">No orders yet</MudText>
            <MudText Typo="Typo.body2" Class="mt-1 mb-4" Style="color: var(--text-dim);">Browse businesses and grab a surprise package!</MudText>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Storefront"
                       Style="background: var(--gradient-primary); color: #fff; text-transform: none; font-weight: 600; border-radius: 12px;"
                       Href="/">
                Browse Businesses
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudTimeline TimelinePosition="TimelinePosition.Start" Class="orders-timeline">
            @foreach (var order in MyOrders.OrderByDescending(o => o.Date))
            {
                <MudTimelineItem Size="MudBlazor.Size.Medium" Color="@GetTimelineColor(order.Status)" Variant="Variant.Filled">
                    <ItemDot>
                        <MudIcon Icon="@GetStatusIcon(order.Status)" Size="MudBlazor.Size.Small" />
                    </ItemDot>
                    <ItemContent>
                        <MudPaper Class="order-card pa-0 rounded-xl" Style="background: var(--bg-surface); border: 1px solid var(--border-color); overflow: hidden;" Elevation="0">
                            <div class="order-card-header">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="px-5 py-3">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="MudBlazor.Size.Small" Style="color: var(--text-dim);" />
                                        <MudText Typo="Typo.body2" Style="color: var(--text-muted);">@order.Date.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</MudText>
                                    </MudStack>
                                    <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Filled"
                                             Style="@GetStatusChipStyle(order.Status)">
                                        @order.Status
                                    </MudChip>
                                </MudStack>
                            </div>
                            <MudDivider Style="border-color: var(--border-color);" />
                            <div class="px-5 py-4">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                    <MudStack Spacing="1">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: var(--text-primary);">
                                            @order.PackageName
                                        </MudText>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                            <MudIcon Icon="@Icons.Material.Filled.Store" Size="MudBlazor.Size.Small" Style="color: var(--accent);" />
                                            <MudLink Href="@($"/business/{order.BusinessId}")" Style="color: var(--accent-light); font-weight: 500; text-decoration: none;">
                                                @order.BusinessName
                                            </MudLink>
                                        </MudStack>
                                    </MudStack>
                                    <MudStack AlignItems="AlignItems.End" Spacing="0">
                                        <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--accent-light);">
                                            @order.Price.ToString("0.00") RON
                                        </MudText>
                                    </MudStack>
                                </MudStack>
                            </div>
                            <div class="order-card-footer px-5 py-3">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.caption" Style="color: var(--text-dim);">
                                        Order #@order.Id
                                    </MudText>
                                    <MudButton Variant="Variant.Text" Size="MudBlazor.Size.Small"
                                               EndIcon="@Icons.Material.Filled.ArrowForward"
                                               Style="color: var(--accent-light); text-transform: none; font-weight: 600;"
                                               Href="@($"/business/{order.BusinessId}")">
                                        View Business
                                    </MudButton>
                                </MudStack>
                            </div>
                            @if (order.Status?.Equals("Completed", StringComparison.OrdinalIgnoreCase) == true)
                            {
                                <MudDivider Style="border-color: var(--border-color);" />
                                <div class="px-5 py-3">
                                    @if (order.IsReviewed || _reviewedOrderIds.Contains(order.Id))
                                    {
                                        <MudStack Spacing="1">
                                            @{
                                                var rating = _submittedReviews.ContainsKey(order.Id)
                                                    ? _submittedReviews[order.Id].Rating
                                                    : order.ReviewRating ?? 0;
                                                var comment = _submittedReviews.ContainsKey(order.Id)
                                                    ? _submittedReviews[order.Id].Comment
                                                    : order.ReviewComment;
                                            }
                                            @if (rating > 0)
                                            {
                                                <MudRating ReadOnly="true"
                                                           SelectedValue="@rating"
                                                           MaxValue="5"
                                                           FullIcon="@Icons.Material.Filled.Star"
                                                           EmptyIcon="@Icons.Material.Filled.StarBorder"
                                                           Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" />
                                            }
                                            @if (!string.IsNullOrEmpty(comment))
                                            {
                                                <MudText Typo="Typo.body2" Style="color: var(--text-secondary); font-style: italic;">
                                                    "@comment"
                                                </MudText>
                                            }
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="MudBlazor.Size.Small" Style="color: var(--accent);" />
                                                <MudText Typo="Typo.caption" Style="color: var(--accent-light); font-weight: 500;">Review submitted</MudText>
                                            </MudStack>
                                        </MudStack>
                                    }
                                    else if (_reviewingOrderId == order.Id)
                                    {
                                        <MudStack Spacing="2">
                                            <MudRating @bind-SelectedValue="_newRating" MaxValue="5"
                                                       FullIcon="@Icons.Material.Filled.Star"
                                                       EmptyIcon="@Icons.Material.Filled.StarBorder"
                                                       Color="MudBlazor.Color.Warning" />
                                            <MudTextField @bind-Value="_newComment" Label="Your review (optional)"
                                                          Variant="Variant.Outlined" Lines="2" Style="color: var(--text-primary);" />
                                            <MudStack Row="true" Spacing="2">
                                                <MudButton Variant="Variant.Filled" Size="MudBlazor.Size.Small"
                                                           StartIcon="@Icons.Material.Filled.Send"
                                                           Style="background: var(--gradient-primary); color: #fff; text-transform: none; font-weight: 600; border-radius: 10px;"
                                                           Disabled="@(_newRating == 0 || _submittingReview)"
                                                           OnClick="@(() => SubmitReview(order.Id, order.BusinessId))">
                                                    @if (_submittingReview)
                                                    {
                                                        <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Style="width:14px;height:14px;color:#fff;" Class="me-1" />
                                                        <span>Submitting…</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Submit Review</span>
                                                    }
                                                </MudButton>
                                                <MudButton Variant="Variant.Text" Size="MudBlazor.Size.Small"
                                                           Style="color: var(--text-muted); text-transform: none;"
                                                           OnClick="CancelReview">
                                                    Cancel
                                                </MudButton>
                                            </MudStack>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Outlined" Size="MudBlazor.Size.Small"
                                                   StartIcon="@Icons.Material.Filled.RateReview"
                                                   Style="color: var(--accent-light); border-color: var(--border-color); text-transform: none; font-weight: 600; border-radius: 10px;"
                                                   OnClick="@(() => StartReview(order.Id))">
                                            Leave a Review
                                        </MudButton>
                                    }
                                </div>
                            }
                        </MudPaper>
                    </ItemContent>
                </MudTimelineItem>
            }
        </MudTimeline>
    }
</MudContainer>
