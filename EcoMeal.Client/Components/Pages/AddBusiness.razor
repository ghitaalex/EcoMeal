@page "/business/add"
@using EcoMeal.Client.Models
@using EcoMeal.Client.Services

<PageTitle>Add Business</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
               Style="text-transform: none; color: #000; font-weight: 600; margin-bottom: 1rem;"
               Href="/">
        Back to Businesses
    </MudButton>

    <MudPaper Class="pa-8 rounded-xl" Elevation="0" Style="border: 1px solid #f0f0f0;">
        <MudText Typo="Typo.h5" Style="font-weight: 800; margin-bottom: 0.5rem;">Add Business</MudText>
        <MudText Typo="Typo.body2" Style="color: #6b7280; margin-bottom: 2rem;">Register a new business on the platform.</MudText>

        <EditForm Model="Model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="Model.Name"
                          Label="Business Name"
                          Placeholder="e.g. Pizza Corner"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="Name is required" />

            <MudTextField @bind-Value="Model.Address"
                          Label="Address"
                          Placeholder="e.g. 123 Main Street"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="Address is required" />

            <MudTextField @bind-Value="Model.Description"
                          Label="Description"
                          Placeholder="Tell customers about this business..."
                          Variant="Variant.Outlined"
                          Lines="3"
                          Class="mb-4" />

            <MudTextField @bind-Value="Model.Contact"
                          Label="Contact"
                          Placeholder="e.g. contact@business.com"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="Contact is required" />

            <MudSelect @bind-Value="Model.BusinessTypeId"
                       Label="Business Type"
                       Variant="Variant.Outlined"
                       Class="mb-6"
                       Required="true"
                       RequiredError="Please select a business type">
                @if (BusinessTypes is not null)
                {
                    @foreach (var type in BusinessTypes)
                    {
                        <MudSelectItem Value="type.Id">@type.Name</MudSelectItem>
                    }
                }
            </MudSelect>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Style="background: #000; color: #fff; text-transform: none; font-weight: 700; font-size: 1rem; padding: 0.75rem;"
                       Size="MudBlazor.Size.Large">
                Create Business
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    [Inject]
    public required BusinessService BusinessService { get; set; }
    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    private List<BusinessTypeModel>? BusinessTypes;

    private BusinessAddModel Model { get; set; } = new()
    {
        Name = string.Empty,
        Address = string.Empty,
        Contact = string.Empty,
        BusinessTypeId = 1
    };

    protected override async Task OnInitializedAsync()
    {
        BusinessTypes = await BusinessService.GetBusinessTypes();
    }

    private async Task HandleSubmit()
    {
        await BusinessService.AddAsync(Model);
        NavigationManager.NavigateTo("/");
    }
}
