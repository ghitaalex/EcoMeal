@page "/business/add"
@using EcoMeal.Client.Models
@using EcoMeal.Client.Services

<PageTitle>Add Business</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
               Style="text-transform: none; color: #34D399; font-weight: 600; margin-bottom: 1rem;"
               Href="/">
        Back to Businesses
    </MudButton>

    <MudPaper Class="pa-8" Elevation="0" Style="border: 1.5px solid #1E3A2F; border-radius: 24px; background: #141A2A;">
        <MudText Typo="Typo.h5" Style="font-weight: 800; margin-bottom: 0.5rem; color: #34D399;">Add Business</MudText>
        <MudText Typo="Typo.body2" Style="color: #94A3B8; margin-bottom: 2rem;">Register a new business on the platform.</MudText>

        <EditForm Model="Model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="Model.Name"
                          Label="Business Name"
                          Placeholder="e.g. Pizza Corner"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="Name is required" />

            <MudTextField @bind-Value="Model.Address"
                          Label="Address"
                          Placeholder="e.g. 123 Main Street"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="Address is required" />

            <MudTextField @bind-Value="Model.Description"
                          Label="Description"
                          Placeholder="Tell customers about this business..."
                          Variant="Variant.Outlined"
                          Lines="3"
                          Class="mb-4" />

            <MudTextField @bind-Value="Model.Contact"
                          Label="Contact"
                          Placeholder="e.g. contact@business.com"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="Contact is required" />

            <MudSelect @bind-Value="Model.BusinessTypeId"
                       Label="Business Type"
                       Variant="Variant.Outlined"
                       Class="mb-6"
                       Required="true"
                       RequiredError="Please select a business type">
                @if (BusinessTypes is not null)
                {
                    @foreach (var type in BusinessTypes)
                    {
                        <MudSelectItem Value="type.Id">@type.Name</MudSelectItem>
                    }
                }
            </MudSelect>

            <MudStack Class="mb-6">
                <MudText Typo="Typo.body2" Style="color: #94A3B8; margin-bottom: 0.5rem;">Image (optional)</MudText>
                <InputFile OnChange="OnImageSelected" accept=".png,.jpg,.jpeg,.webp" class="form-control" />
                @if (SelectedImage is not null)
                {
                    <MudText Typo="Typo.caption" Style="color: #94A3B8;">@SelectedImage.Name</MudText>
                }
            </MudStack>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Style="background: linear-gradient(135deg, #047857 0%, #065F46 100%); color: #fff; text-transform: none; font-weight: 700; font-size: 1rem; padding: 0.75rem; border-radius: 12px; box-shadow: 0 4px 14px rgba(4, 120, 87, 0.3);"
                       Size="MudBlazor.Size.Large">
                Create Business
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    [Inject]
    public required BusinessService BusinessService { get; set; }
    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    private List<BusinessTypeModel>? BusinessTypes;
    private IBrowserFile? SelectedImage;

    private BusinessAddModel Model { get; set; } = new()
    {
        Name = string.Empty,
        Address = string.Empty,
        Contact = string.Empty,
        BusinessTypeId = 1
    };

    protected override async Task OnInitializedAsync()
    {
        BusinessTypes = await BusinessService.GetBusinessTypes();
    }

    private async Task HandleSubmit()
    {
        await BusinessService.AddAsync(Model, SelectedImage);
        NavigationManager.NavigateTo("/");
    }

    private void OnImageSelected(InputFileChangeEventArgs e)
    {
        SelectedImage = e.File;
    }
}
