@page "/business/{BusinessId:int}/addPackage"
@using EcoMeal.Client.Models
@using EcoMeal.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Add Package</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
               Style="text-transform: none; color: var(--accent-text); font-weight: 600; margin-bottom: 1rem;"
               OnClick="NavigateBack">
        Back to Business
    </MudButton>

    <MudPaper Class="pa-8" Elevation="0" Style="border: 1.5px solid var(--border-color); border-radius: 24px; background: var(--bg-surface);">
        <MudText Typo="Typo.h5" Style="font-weight: 800; margin-bottom: 0.5rem; color: var(--accent-text);">Add Package</MudText>
        <MudText Typo="Typo.body2" Style="color: var(--text-muted); margin-bottom: 2rem;">Create a new surprise package for customers to pick up.</MudText>

        <EditForm Model="PackageAddModel" OnValidSubmit="AddPackageToBusiness">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="PackageAddModel.Name"
                          Label="Package Name"
                          Placeholder="e.g. Mystery Bakery Box"
                          Variant="Variant.Outlined"
                          Class="mb-4"
                          Required="true"
                          RequiredError="Name is required" />

            <MudTextField @bind-Value="PackageAddModel.Description"
                          Label="Description"
                          Placeholder="Describe what the customer might expect..."
                          Variant="Variant.Outlined"
                          Lines="3"
                          Class="mb-4" />

            <MudNumericField @bind-Value="PackageAddModel.Price"
                             Label="Price"
                             Variant="Variant.Outlined"
                             Adornment="Adornment.Start"
                             AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                             Min="0.01"
                             Class="mb-4" />

            <MudNumericField @bind-Value="PackageAddModel.NoPackages"
                             Label="Number of Packages"
                             Variant="Variant.Outlined"
                             Min="1"
                             Class="mb-4" />

            <MudGrid Spacing="3" Class="mb-4">
                <MudItem xs="12" sm="6">
                    <label class="form-label">Pickup Start</label>
                    <InputDate @bind-Value="PackageAddModel.StartPickup"
                               Type="InputDateType.DateTimeLocal"
                               class="form-control" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <label class="form-label">Pickup End</label>
                    <InputDate @bind-Value="PackageAddModel.EndPickup"
                               Type="InputDateType.DateTimeLocal"
                               class="form-control" />
                </MudItem>
            </MudGrid>

            <MudSelect @bind-Value="PackageAddModel.PackageTypeId"
                       Label="Package Type"
                       Variant="Variant.Outlined"
                       Class="mb-6"
                       Required="true"
                       RequiredError="Please select a package type">
                @if (PackageTypes is not null)
                {
                    @foreach (var type in PackageTypes)
                    {
                        <MudSelectItem Value="type.Id">@type.Name</MudSelectItem>
                    }
                }
            </MudSelect>

            <MudStack Class="mb-6">
                <MudText Typo="Typo.body2" Style="color: var(--text-muted); margin-bottom: 0.5rem;">Image (optional)</MudText>
                <InputFile OnChange="OnImageSelected" accept=".png,.jpg,.jpeg,.webp" class="form-control" />
                @if (SelectedImage is not null)
                {
                    <MudText Typo="Typo.caption" Style="color: var(--text-muted);">@SelectedImage.Name</MudText>
                }
            </MudStack>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       FullWidth="true"
                       Style="background: var(--gradient-primary); color: #fff; text-transform: none; font-weight: 700; font-size: 1rem; padding: 0.75rem; border-radius: 12px; box-shadow: var(--glow-sm);"
                       Size="MudBlazor.Size.Large">
                Create Package
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    [Parameter]
    public int BusinessId { get; set; }

    [Inject]
    public required PackageService PackageService { get; set; }
    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    private List<PackageTypeModel>? PackageTypes;
    private IBrowserFile? SelectedImage;

    public PackageAddModel PackageAddModel { get; set; } = new PackageAddModel()
    {
        Name = string.Empty,
        Description = string.Empty,
        Price = 0,
        NoPackages = 1,
        PackageTypeId = 1,
        StartPickup = DateTime.Now,
        EndPickup = DateTime.Now.AddHours(2)
    };

    protected override async Task OnInitializedAsync()
    {
        PackageTypes = await PackageService.GetPackageTypes();
    }

    public async Task AddPackageToBusiness()
    {
        await PackageService.AddAsync(BusinessId, PackageAddModel, SelectedImage);
        NavigationManager.NavigateTo($"/business/{BusinessId}");
    }

    private void OnImageSelected(InputFileChangeEventArgs e)
    {
        SelectedImage = e.File;
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo($"/business/{BusinessId}");
    }
}
