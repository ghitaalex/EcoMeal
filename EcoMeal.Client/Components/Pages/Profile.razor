@page "/profile"
@using EcoMeal.Client.Models
@using EcoMeal.Client.Models.Auth
@using EcoMeal.Client.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject AuthService AuthService
@inject OrderService OrderService
@inject NavigationManager Navigation

<PageTitle>Profile | EcoMeal</PageTitle>

<div class="profile-wrapper">
    <div class="profile-card">
        <div class="profile-header">
            <div class="profile-avatar">
                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            </div>
            <h2>My Profile</h2>
            <p class="profile-subtitle">Manage your account information</p>
        </div>

        @if (isLoading)
        {
            <div class="profile-loading">
                <MudProgressCircular Color="Color.Success" Size="Size.Medium" Indeterminate="true" />
            </div>
        }
        else if (profile == null)
        {
            <div class="profile-error">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                Failed to load profile.
            </div>
        }
        else if (!isEditing)
        {
            <div class="profile-info">
                <div class="info-row">
                    <div class="info-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                    </div>
                    <div class="info-content">
                        <span class="info-label">Email</span>
                        <span class="info-value">@profile.Email</span>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <div class="info-content">
                        <span class="info-label">Name</span>
                        <span class="info-value">@profile.Name</span>
                    </div>
                </div>

                <div class="info-row">
                    <div class="info-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </div>
                    <div class="info-content">
                        <span class="info-label">Contact</span>
                        <span class="info-value">@(string.IsNullOrEmpty(profile.Contact) ? "Not provided" : profile.Contact)</span>
                    </div>
                </div>

                @if (profile.Roles.Contains("Admin"))
                {
                    <div class="info-row">
                        <div class="info-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
                        </div>
                        <div class="info-content">
                            <span class="info-label">Roles</span>
                            <div class="roles-list">
                                @foreach (var role in profile.Roles)
                                {
                                    <span class="role-badge">@role</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <button class="btn profile-btn" @onclick="StartEditing">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                <span>Edit Profile</span>
            </button>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="profile-error">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                    @errorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="profile-success">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    @successMessage
                </div>
            }

            <EditForm Model="editModel" OnValidSubmit="HandleSave" FormName="profileEditForm">
                <DataAnnotationsValidator />

                <div class="auth-field">
                    <div class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    </div>
                    <InputText class="form-control auth-input" placeholder="Full name" @bind-Value="editModel.Name" />
                    <ValidationMessage For="() => editModel.Name" />
                </div>

                <div class="auth-field">
                    <div class="input-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </div>
                    <InputText class="form-control auth-input" placeholder="Contact info" @bind-Value="editModel.Contact" />
                    <ValidationMessage For="() => editModel.Contact" />
                </div>

                <div class="profile-actions">
                    <button type="submit" class="btn profile-btn" disabled="@isSaving">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        <span>@(isSaving ? "Saving..." : "Save Changes")</span>
                    </button>
                    <button type="button" class="btn profile-btn-secondary" @onclick="CancelEditing">
                        <span>Cancel</span>
                    </button>
                </div>
            </EditForm>
        }
    </div>

    <div class="profile-card orders-card">
        <div class="orders-header">
            <div class="orders-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </div>
            <div>
                <h3>Order History</h3>
                <p class="orders-subtitle">@(orders?.Count > 0 ? $"{orders.Count} order(s)" : "Your past orders will appear here")</p>
            </div>
        </div>

        @if (ordersLoading)
        {
            <div class="profile-loading">
                <MudProgressCircular Color="Color.Success" Size="Size.Small" Indeterminate="true" />
            </div>
        }
        else if (orders == null || !orders.Any())
        {
            <div class="orders-empty">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M16 16s-1.5-2-4-2-4 2-4 2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                <p>No orders yet</p>
                <span>When you place orders, they'll show up here.</span>
            </div>
        }
        else
        {
            <div class="orders-list">
                @foreach (var order in orders.OrderByDescending(o => o.Date))
                {
                    <div class="order-item">
                        <div class="order-item-left">
                            <div class="order-status-dot @GetStatusClass(order.Status)"></div>
                            <div class="order-item-info">
                                <span class="order-item-name">@order.PackageName</span>
                                <span class="order-item-business">@order.BusinessName</span>
                            </div>
                        </div>
                        <div class="order-item-right">
                            <span class="order-item-price">@order.Price.ToString("0.00") RON</span>
                            <span class="order-item-date">@order.Date.ToLocalTime().ToString("dd MMM")</span>
                        </div>
                    </div>
                }
            </div>
            <a href="/orders" class="orders-view-all">View all orders →</a>
        }
    </div>
</div>

@code {
    private UserMeResponse? profile;
    private List<OrderGetModel>? orders;
    private ProfileUpdateModel editModel = new();
    private bool isLoading = true;
    private bool ordersLoading = true;
    private bool isEditing;
    private bool isSaving;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            profile = await AuthService.GetProfileAsync();
            isLoading = false;
            StateHasChanged();

            try
            {
                orders = await OrderService.GetMyOrderAsync();
            }
            catch
            {
                orders = new();
            }
            ordersLoading = false;
            StateHasChanged();
        }
    }

    private void StartEditing()
    {
        editModel.Name = profile?.Name ?? "";
        editModel.Contact = profile?.Contact ?? "";
        errorMessage = null;
        successMessage = null;
        isEditing = true;
    }

    private void CancelEditing()
    {
        isEditing = false;
        errorMessage = null;
        successMessage = null;
    }

    private async Task HandleSave()
    {
        isSaving = true;
        errorMessage = null;
        successMessage = null;

        var result = await AuthService.UpdateProfileAsync(editModel.Name, editModel.Contact);

        if (result.Success)
        {
            profile!.Name = editModel.Name;
            profile.Contact = editModel.Contact;
            successMessage = "Profile updated successfully.";
            isEditing = false;
        }
        else
        {
            errorMessage = result.ErrorMessage;
        }

        isSaving = false;
    }

    private string GetStatusClass(string status) => status?.ToLower() switch
    {
        "completed" => "status-completed",
        "pending" => "status-pending",
        "cancelled" => "status-cancelled",
        _ => "status-pending"
    };
}
