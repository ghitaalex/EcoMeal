@page "/business/{Id:int}"
@using EcoMeal.Client.Services
@using EcoMeal.Client.Models
@implements IAsyncDisposable

<PageTitle>@(Business is null ? "Business Details | EcoMeal" : $"{Business.Name} | EcoMeal")</PageTitle>

@if (Business is null)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex justify-center align-center" Style="min-height: 60vh;">
        <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Success" />
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="business-details-container py-8">
        <MudPaper Class="business-hero pa-8" Elevation="0"
                  Style="@($"color: #fff; border-radius: 24px; background: {(string.IsNullOrEmpty(Business.BusinessImageUrl) ? "var(--gradient-default)" : $"url('{Business.BusinessImageUrl}') center/cover no-repeat")}; position: relative; overflow: hidden;")">
            <div style="position: absolute; inset: 0; background: var(--gradient-hero);"></div>
            <div style="position: relative; z-index: 1;">
            <AuthorizeView>
                <button type="button"
                        class="detail-favorite-button @(Business.IsFavorite ? "active" : null)"
                        title="@(Business.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                        aria-label="@(Business.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                        disabled="@_updatingFavorite"
                        @onclick="ToggleFavorite">
                    @if (_updatingFavorite)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi @(Business.IsFavorite ? "bi-heart-fill" : "bi-heart")"></i>
                    }
                </button>
            </AuthorizeView>
            <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Filled" Style="background: rgba(29, 73, 52, 0.4); color: #fff; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(4px);">
                @Business.BusinessTypeName
            </MudChip>
            <MudText Typo="Typo.h3" Class="mt-4 mb-2" Style="font-weight: 700; letter-spacing: -0.5px;">
                @Business.Name
            </MudText>
            @if (!string.IsNullOrEmpty(Business.Description))
            {
                <MudText Typo="Typo.body1" Style="color: rgba(255,255,255,0.8);">
                    @Business.Description
                </MudText>
            }
            <MudStack Row="true" Spacing="3" Class="mt-5" Wrap="Wrap.Wrap">
                <MudChip T="string" Icon="@Icons.Material.Filled.LocationOn" Variant="Variant.Filled"
                         Style="background: rgba(255,255,255,0.12); color: #fff; backdrop-filter: blur(4px);">
                    @Business.Address
                </MudChip>
                <MudChip T="string" Icon="@Icons.Material.Filled.Email" Variant="Variant.Filled"
                         Style="background: rgba(255,255,255,0.12); color: #fff; backdrop-filter: blur(4px);">
                    @Business.Contact
                </MudChip>
            </MudStack>
            </div>
        </MudPaper>

        <section class="business-location-section">
            <div class="business-location-heading">
                <div>
                    <span class="location-kicker">Location</span>
                    <MudText Typo="Typo.h5">Find @Business.Name</MudText>
                    <MudText Typo="Typo.body2">@Business.Address</MudText>
                </div>
                <a class="open-map-link" href="@GoogleMapsUrl" target="_blank" rel="noopener noreferrer">
                    <i class="bi bi-google"></i>
                    Open in Google Maps
                </a>
            </div>

            @if (Business.Latitude.HasValue && Business.Longitude.HasValue)
            {
                @if (_mapError is not null)
                {
                    <div class="business-map-fallback" role="alert">
                        <MudIcon Icon="@Icons.Material.Outlined.Map" />
                        <span>@_mapError</span>
                    </div>
                }
                else
                {
                    <div @key="Business.Id" @ref="_mapElement" id="@MapElementId" class="detail-business-map" aria-label="Map showing @Business.Name"></div>
                }
            }
            else
            {
                <div class="business-map-fallback">
                    <MudIcon Icon="@Icons.Material.Outlined.LocationOff" />
                    <span>The map preview is not available yet. You can still open this address in Google Maps.</span>
                </div>
            }
        </section>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="detail-section-heading mt-8 mb-4">
            <MudText Typo="Typo.h5" Style="font-weight: 600; color: var(--accent-text);">Available Packages</MudText>
            <AuthorizeView Roles="Admin">
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           Style="background: var(--gradient-primary); color: #fff; text-transform: none; font-weight: 700; border-radius: 12px; box-shadow: var(--glow-sm);"
                           OnClick="NavigateToAddPackage">
                    Add Package
                </MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ListAlt"
                           Style="color: var(--accent-text); border-color: var(--border-color); text-transform: none; font-weight: 700; border-radius: 12px;"
                           Href="@($"/business/{Id}/orders")">
                    Manage Orders
                </MudButton>
            </AuthorizeView>
        </MudStack>

        @if (Packages is null)
        {
            <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Success" Class="my-4" />
        }
        else if (Packages.Count == 0)
        {
            <MudPaper Class="pa-10 rounded-xl d-flex flex-column align-center justify-center" Style="border: 2px dashed var(--border-color); background: var(--bg-surface);" Elevation="0">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Style="font-size: 3.5rem; color: var(--accent);" />
                <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--text-secondary);">No packages yet</MudText>
                <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--text-dim);">Create your first package to get started</MudText>
                <AuthorizeView Roles="Admin">
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                               Style="background: var(--gradient-primary); color: #fff; text-transform: none; font-weight: 700; border-radius: 12px; box-shadow: var(--glow-sm);"
                               OnClick="NavigateToAddPackage">
                        Add Package
                    </MudButton>
                </AuthorizeView>
            </MudPaper>
        }
        else
        {
            <MudGrid Spacing="4">
                @foreach (var package in Packages)
                {
                    var isSoldOut = package.AvailablePackages <= 0;
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="rounded-xl" Style="border: 1px solid var(--border-color); background: var(--bg-surface); height: 100%; transition: box-shadow 0.25s, transform 0.25s; overflow: hidden;">
                            <div style="height: 140px; border-radius: 12px 12px 0 0; overflow: hidden; position: relative; @(string.IsNullOrEmpty(package.PackageImageUrl) ? "background: var(--gradient-default);" : $"background: url('{package.PackageImageUrl}') center/cover no-repeat;")">
                                @if (!string.IsNullOrEmpty(package.PackageImageUrl))
                                {
                                    <div style="position: absolute; inset: 0; background: var(--gradient-hero);"></div>
                                }
                            </div>
                            <MudCardContent Class="pa-5">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Filled"
                                             Style="background: var(--chip-bg); color: var(--accent-light); font-weight: 600; text-transform: uppercase; font-size: 0.7rem;">
                                        @package.PackageTypeName
                                    </MudChip>
                                    <MudText Typo="Typo.h6" Style="font-weight: 700; color: var(--accent-light);">
                                        @package.Price.ToString("0.00") RON
                                    </MudText>
                                </MudStack>
                                <MudText Typo="Typo.subtitle1" Class="mt-3" Style="font-weight: 600; color: var(--text-primary);">
                                    @package.Name
                                </MudText>
                                @if (!string.IsNullOrEmpty(package.Description))
                                {
                                    <MudText Typo="Typo.body2" Class="mt-1" Style="color: var(--text-secondary);">
                                        @package.Description
                                    </MudText>
                                }
                                <MudDivider Class="my-3" Style="border-color: var(--border-color);" />
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                    <MudText Typo="Typo.caption" Style="color: var(--text-muted);">Packages left</MudText>
                                    <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Filled"
                                             Style="@(isSoldOut ? "background: var(--status-cancelled-bg); color: #FCA5A5; font-weight: 600;" : "background: var(--chip-bg); color: var(--accent-light); font-weight: 600;")">
                                        @Math.Max(0, package.AvailablePackages)
                                    </MudChip>
                                </MudStack>
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="MudBlazor.Size.Small" Style="color: var(--accent);" />
                                        <MudText Typo="Typo.body2" Style="color: var(--text-secondary);">
                                            @package.PickUpStart.ToLocalTime().ToString("HH:mm") – @package.PickUpEnd.ToLocalTime().ToString("HH:mm")
                                        </MudText>
                                    </MudStack>
                                    <AuthorizeView Roles="Admin">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="MudBlazor.Size.Small"
                                                       Style="color: var(--accent-light);"
                                                       OnClick="() => NavigateToEditPackage(package.Id)" />
                                    </AuthorizeView>
                                </MudStack>
                                <AuthorizeView>
                                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ShoppingCart"
                                               FullWidth="true" Class="mt-3"
                                               Style="background: var(--gradient-primary); color: #fff; text-transform: none; font-weight: 600; border-radius: 10px; box-shadow: var(--glow-sm);"
                                               Disabled="@(_orderingPackageId == package.Id || isSoldOut)"
                                               OnClick="() => PlaceOrder(package.Id)">
                                        @if (_orderingPackageId == package.Id)
                                        {
                                            <MudProgressCircular Size="MudBlazor.Size.Small" Indeterminate="true" Style="width:16px;height:16px;color:#fff;" Class="me-2" />
                                            <span>Placing order…</span>
                                        }
                                        else if (isSoldOut)
                                        {
                                            <span>Sold Out</span>
                                        }
                                        else
                                        {
                                            <span>Order Now</span>
                                        }
                                    </MudButton>
                                </AuthorizeView>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }

        <MudText Typo="Typo.h5" Class="mt-10 mb-4" Style="font-weight: 600; color: var(--accent-text);">Reviews</MudText>

        @if (Reviews is null)
        {
            <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Success" Class="my-4" />
        }
        else if (!Reviews.Any())
        {
            <MudPaper Class="pa-8 rounded-xl d-flex flex-column align-center" Style="border: 1px dashed var(--border-color); background: var(--bg-surface);" Elevation="0">
                <MudIcon Icon="@Icons.Material.Outlined.Reviews" Style="font-size: 2.5rem; color: var(--accent);" />
                <MudText Typo="Typo.body1" Class="mt-3" Style="color: var(--text-dim);">No reviews yet</MudText>
            </MudPaper>
        }
        else
        {
            <MudStack Spacing="3">
                @foreach (var review in Reviews)
                {
                    <MudPaper Class="pa-5 rounded-xl" Style="background: var(--bg-surface); border: 1px solid var(--border-color);" Elevation="0">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                            <MudStack Spacing="1">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudAvatar Size="MudBlazor.Size.Small" Style="background: var(--gradient-primary); color: #fff; font-size: 0.75rem;">
                                        @(review.UserName?.Length > 0 ? review.UserName[0].ToString().ToUpper() : "?")
                                    </MudAvatar>
                                    <MudText Typo="Typo.subtitle2" Style="color: var(--text-primary); font-weight: 600;">@review.UserName</MudText>
                                    <MudText Typo="Typo.caption" Style="color: var(--text-dim);">@review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</MudText>
                                </MudStack>
                                <MudRating ReadOnly="true" SelectedValue="@review.Rating" MaxValue="5"
                                           FullIcon="@Icons.Material.Filled.Star" EmptyIcon="@Icons.Material.Filled.StarBorder"
                                           Color="MudBlazor.Color.Warning" Size="MudBlazor.Size.Small" />
                                @if (!string.IsNullOrEmpty(review.Comment))
                                {
                                    <MudText Typo="Typo.body2" Class="mt-1" Style="color: var(--text-secondary);">@review.Comment</MudText>
                                }
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            </MudStack>
        }

        <AuthorizeView>
            @if (MyBusinessOrders is not null && MyBusinessOrders.Any())
            {
                <MudText Typo="Typo.h5" Class="mt-10 mb-4" Style="font-weight: 600; color: var(--accent-light);">Your Orders Here</MudText>
                <MudStack Spacing="3">
                    @foreach (var order in MyBusinessOrders.OrderByDescending(o => o.Date))
                    {
                        <MudPaper Class="pa-4 rounded-xl" Style="background: var(--bg-surface); border: 1px solid var(--border-color);" Elevation="0">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2" Style="color: var(--text-primary); font-weight: 600;">@order.PackageName</MudText>
                                    <MudText Typo="Typo.caption" Style="color: var(--text-dim);">@order.Date.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</MudText>
                                </MudStack>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.body2" Style="color: var(--accent-light); font-weight: 600;">@order.Price.ToString("0.00") RON</MudText>
                                    <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Filled"
                                             Style="@GetStatusChipStyle(order.Status)">
                                        @order.Status
                                    </MudChip>
                                </MudStack>
                            </MudStack>
                        </MudPaper>
                    }
                </MudStack>
            }
        </AuthorizeView>
    </MudContainer>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [Inject]
    public required BusinessService businessService { get; set; }
    [Inject]
    public required PackageService packageService { get; set; }
    [Inject]
    public required OrderService orderService { get; set; }
    [Inject]
    public required ReviewService reviewService { get; set; }
    [Inject]
    public required NavigationManager NavigationManager { get; set; }
    [Inject]
    public required ISnackbar Snackbar { get; set; }
    [Inject]
    public required IJSRuntime JS { get; set; }

    private string MapElementId => $"business-detail-map-{Id}";
    private BusinessDetailsModel? Business;
    private List<PackageGetModel>? Packages;
    private List<ReviewGetModel>? Reviews;
    private List<OrderGetModel>? MyBusinessOrders;
    private int? _orderingPackageId;
    private bool _updatingFavorite;
    private IJSObjectReference? _mapModule;
    private ElementReference _mapElement;
    private string? _mapError;
    private bool _mapRendered;

    private string GoogleMapsUrl => Business is null
        ? "https://www.google.com/maps"
        : $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(Business.Address)}";

    protected override async Task OnInitializedAsync()
    {
        Business = await businessService.GetOneById(Id);
        if (Business is not null)
        {
            var favoriteIds = await businessService.GetFavoriteIdsAsync();
            Business.IsFavorite = favoriteIds.Contains(Id);
        }
        StateHasChanged();

        Packages = await packageService.GetByBusinessId(Id);
        Reviews = await reviewService.GetByBusinessAsync(Id);
        try
        {
            var allOrders = await orderService.GetMyOrderAsync();
            MyBusinessOrders = allOrders.Where(o => o.BusinessId == Id).ToList();
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_mapRendered || Business is null ||
            !Business.Latitude.HasValue || !Business.Longitude.HasValue)
            return;

        try
        {
            _mapModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/businessMap.js");
            var marker = new MapBusinessMarkerModel[]
            {
                new()
                {
                    Id = Business.Id,
                    Name = Business.Name,
                    Address = Business.Address,
                    BusinessTypeName = Business.BusinessTypeName,
                    Latitude = Business.Latitude.Value,
                    Longitude = Business.Longitude.Value,
                }
            };
            await _mapModule.InvokeVoidAsync("renderBusinessMap", _mapElement, marker, null, false);
            _mapRendered = true;
        }
        catch (JSException)
        {
            _mapError = "The map could not be displayed. Check your internet connection and refresh the page.";
            StateHasChanged();
        }
    }

    private async Task PlaceOrder(int packageId)
    {
        _orderingPackageId = packageId;
        StateHasChanged();

        var result = await orderService.PlaceOrderAsync(packageId);
        if (result.Success)
        {
            Snackbar.Add("Order placed successfully!", Severity.Success);
            Packages = await packageService.GetByBusinessId(Id);
            var allOrders = await orderService.GetMyOrderAsync();
            MyBusinessOrders = allOrders.Where(o => o.BusinessId == Id).ToList();
        }
        else
        {
            Snackbar.Add($"Failed to place order: {result.Error}", Severity.Error);
            Packages = await packageService.GetByBusinessId(Id);
        }

        _orderingPackageId = null;
    }

    private async Task ToggleFavorite()
    {
        if (Business is null)
            return;

        _updatingFavorite = true;

        var success = Business.IsFavorite
            ? await businessService.RemoveFavoriteAsync(Business.Id)
            : await businessService.AddFavoriteAsync(Business.Id);

        if (success)
        {
            Business.IsFavorite = !Business.IsFavorite;
        }
        else
        {
            Snackbar.Add("Could not update favorites.", Severity.Error);
        }

        _updatingFavorite = false;
    }

    private static string GetStatusChipStyle(string status)
    {
        return status?.ToLower() switch
        {
            "completed" or "picked up" => "background: rgba(5, 150, 105, 0.15); color: var(--accent-text); font-weight: 600;",
            "cancelled" => "background: rgba(239, 68, 68, 0.15); color: #FCA5A5; font-weight: 600;",
            "pending" => "background: rgba(245, 158, 11, 0.15); color: #FCD34D; font-weight: 600;",
            _ => "background: rgba(59, 130, 246, 0.15); color: #93C5FD; font-weight: 600;"
        };
    }

    public void NavigateToAddPackage()
    {
        NavigationManager.NavigateTo($"business/{Id}/addPackage");
    }

    public void NavigateToEditPackage(int packageId)
    {
        NavigationManager.NavigateTo($"business/{Id}/editPackage/{packageId}");
    }

    public async ValueTask DisposeAsync()
    {
        if (_mapModule is null)
            return;

        try
        {
            await _mapModule.InvokeVoidAsync("disposeBusinessMap", MapElementId);
            await _mapModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
