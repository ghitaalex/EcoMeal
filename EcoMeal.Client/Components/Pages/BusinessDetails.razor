@page "/business/{Id:int}"
@using EcoMeal.Client.Services
@using EcoMeal.Client.Models

<PageTitle>@(Business?.Name ?? "Business Details")</PageTitle>

@if (Business is null)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex justify-center align-center" Style="min-height: 60vh;">
        <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Dark" />
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <MudPaper Class="pa-8 rounded-xl" Elevation="0"
                  Style="@($"color: #fff; background: {(string.IsNullOrEmpty(Business.BusinessImageUrl) ? "#000" : $"url('{Business.BusinessImageUrl}') center/cover no-repeat")}; position: relative; overflow: hidden;")">
            <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.55);"></div>
            <div style="position: relative; z-index: 1;">
            <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Outlined" Style="color: #fff; border-color: rgba(255,255,255,0.3);">
                @Business.BusinessTypeName
            </MudChip>
            <MudText Typo="Typo.h3" Class="mt-4 mb-2" Style="font-weight: 800; letter-spacing: -0.5px;">
                @Business.Name
            </MudText>
            @if (!string.IsNullOrEmpty(Business.Description))
            {
                <MudText Typo="Typo.body1" Style="color: rgba(255,255,255,0.7);">
                    @Business.Description
                </MudText>
            }
            <MudStack Row="true" Spacing="3" Class="mt-5" Wrap="Wrap.Wrap">
                <MudChip T="string" Icon="@Icons.Material.Filled.LocationOn" Variant="Variant.Filled"
                         Style="background: rgba(255,255,255,0.1); color: #fff;">
                    @Business.Address
                </MudChip>
                <MudChip T="string" Icon="@Icons.Material.Filled.Email" Variant="Variant.Filled"
                         Style="background: rgba(255,255,255,0.1); color: #fff;">
                    @Business.Contact
                </MudChip>
            </MudStack>
            </div>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-8 mb-4">
            <MudText Typo="Typo.h5" Style="font-weight: 700;">Available Packages</MudText>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                       Style="background: #000; color: #fff; text-transform: none; font-weight: 600;"
                       OnClick="NavigateToAddPackage">
                Add Package
            </MudButton>
        </MudStack>

        @if (Packages is null)
        {
            <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Dark" Class="my-4" />
        }
        else if (Packages.Count == 0)
        {
            <MudPaper Class="pa-10 rounded-xl d-flex flex-column align-center justify-center" Style="border: 2px dashed #e0e0e0;" Elevation="0">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Style="font-size: 3.5rem; color: #bdbdbd;" />
                <MudText Typo="Typo.h6" Class="mt-4" Style="color: #9e9e9e;">No packages yet</MudText>
                <MudText Typo="Typo.body2" Class="mb-4" Style="color: #bdbdbd;">Create your first package to get started</MudText>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           Style="background: #000; color: #fff; text-transform: none; font-weight: 600;"
                           OnClick="NavigateToAddPackage">
                    Add Package
                </MudButton>
            </MudPaper>
        }
        else
        {
            <MudGrid Spacing="4">
                @foreach (var package in Packages)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="rounded-xl" Style="border: 1px solid #f0f0f0; height: 100%; transition: box-shadow 0.2s, transform 0.2s;">
                            @if (!string.IsNullOrEmpty(package.PackageImageUrl))
                            {
                                <MudCardMedia Image="@package.PackageImageUrl" Height="140" />
                            }
                            <MudCardContent Class="pa-5">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Filled"
                                             Style="background: #f5f5f5; color: #424242; font-weight: 600; text-transform: uppercase; font-size: 0.7rem;">
                                        @package.PackageTypeName
                                    </MudChip>
                                    <MudText Typo="Typo.h6" Style="font-weight: 800;">
                                        @package.Price.ToString("C")
                                    </MudText>
                                </MudStack>
                                <MudText Typo="Typo.subtitle1" Class="mt-3" Style="font-weight: 700;">
                                    @package.Name
                                </MudText>
                                @if (!string.IsNullOrEmpty(package.Description))
                                {
                                    <MudText Typo="Typo.body2" Class="mt-1" Style="color: #6b7280;">
                                        @package.Description
                                    </MudText>
                                }
                                <MudDivider Class="my-3" />
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="MudBlazor.Size.Small" Style="color: #000;" />
                                        <MudText Typo="Typo.body2" Style="color: #4b5563;">
                                            @package.PickUpStart.ToString("HH:mm") – @package.PickUpEnd.ToString("HH:mm")
                                        </MudText>
                                    </MudStack>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="MudBlazor.Size.Small"
                                                   Style="color: #000;"
                                                   OnClick="() => NavigateToEditPackage(package.Id)" />
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudContainer>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [Inject]
    public required BusinessService businessService { get; set; }
    [Inject]
    public required PackageService packageService { get; set; }
    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    private BusinessDetailsModel? Business;
    private List<PackageGetModel>? Packages;

    protected override async Task OnInitializedAsync()
    {
        Business = await businessService.GetOneById(Id);
        Packages = await packageService.GetByBusinessId(Id);
    }

    public void NavigateToAddPackage()
    {
        NavigationManager.NavigateTo($"business/{Id}/addPackage");
    }

    public void NavigateToEditPackage(int packageId)
    {
        NavigationManager.NavigateTo($"business/{Id}/editPackage/{packageId}");
    }
}
