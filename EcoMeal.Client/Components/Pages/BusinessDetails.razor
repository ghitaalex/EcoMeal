@page "/business/{Id:int}"
@using EcoMeal.Client.Services
@using EcoMeal.Client.Models

<PageTitle>@(Business?.Name ?? "Business Details")</PageTitle>

@if (Business is null)
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex justify-center align-center" Style="min-height: 60vh;">
        <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Success" />
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <MudPaper Class="pa-8" Elevation="0"
                  Style="@($"color: #fff; border-radius: 24px; background: {(string.IsNullOrEmpty(Business.BusinessImageUrl) ? "linear-gradient(135deg, #0B0F19 0%, #047857 100%)" : $"url('{Business.BusinessImageUrl}') center/cover no-repeat")}; position: relative; overflow: hidden;")">
            <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(4, 120, 87, 0.2) 0%, rgba(4, 120, 87, 0.8) 100%);"></div>
            <div style="position: relative; z-index: 1;">
            <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Filled" Style="background: rgba(5, 150, 105, 0.35); color: #fff; border: 1px solid rgba(255,255,255,0.15); backdrop-filter: blur(4px);">
                @Business.BusinessTypeName
            </MudChip>
            <MudText Typo="Typo.h3" Class="mt-4 mb-2" Style="font-weight: 700; letter-spacing: -0.5px;">
                @Business.Name
            </MudText>
            @if (!string.IsNullOrEmpty(Business.Description))
            {
                <MudText Typo="Typo.body1" Style="color: rgba(255,255,255,0.8);">
                    @Business.Description
                </MudText>
            }
            <MudStack Row="true" Spacing="3" Class="mt-5" Wrap="Wrap.Wrap">
                <MudChip T="string" Icon="@Icons.Material.Filled.LocationOn" Variant="Variant.Filled"
                         Style="background: rgba(255,255,255,0.12); color: #fff; backdrop-filter: blur(4px);">
                    @Business.Address
                </MudChip>
                <MudChip T="string" Icon="@Icons.Material.Filled.Email" Variant="Variant.Filled"
                         Style="background: rgba(255,255,255,0.12); color: #fff; backdrop-filter: blur(4px);">
                    @Business.Contact
                </MudChip>
            </MudStack>
            </div>
        </MudPaper>

        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-8 mb-4">
            <MudText Typo="Typo.h5" Style="font-weight: 600; color: #6EE7B7;">Available Packages</MudText>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                       Style="background: linear-gradient(135deg, #047857 0%, #065F46 100%); color: #fff; text-transform: none; font-weight: 700; border-radius: 12px; box-shadow: 0 4px 14px rgba(4, 120, 87, 0.3);"
                       OnClick="NavigateToAddPackage">
                Add Package
            </MudButton>
        </MudStack>

        @if (Packages is null)
        {
            <MudProgressLinear Indeterminate="true" Color="MudBlazor.Color.Success" Class="my-4" />
        }
        else if (Packages.Count == 0)
        {
            <MudPaper Class="pa-10 rounded-xl d-flex flex-column align-center justify-center" Style="border: 2px dashed #1E3A2F; background: #141A2A;" Elevation="0">
                <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Style="font-size: 3.5rem; color: #047857;" />
                <MudText Typo="Typo.h6" Class="mt-4" Style="color: #CBD5E1;">No packages yet</MudText>
                <MudText Typo="Typo.body2" Class="mb-4" Style="color: #64748B;">Create your first package to get started</MudText>
                <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                           Style="background: linear-gradient(135deg, #047857 0%, #065F46 100%); color: #fff; text-transform: none; font-weight: 700; border-radius: 12px; box-shadow: 0 4px 14px rgba(4, 120, 87, 0.3);"
                           OnClick="NavigateToAddPackage">
                    Add Package
                </MudButton>
            </MudPaper>
        }
        else
        {
            <MudGrid Spacing="4">
                @foreach (var package in Packages)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="0" Class="rounded-xl" Style="border: 1px solid #1E3A2F; background: #141A2A; height: 100%; transition: box-shadow 0.25s, transform 0.25s;">
                            @if (!string.IsNullOrEmpty(package.PackageImageUrl))
                            {
                                <MudCardMedia Image="@package.PackageImageUrl" Height="140" />
                            }
                            <MudCardContent Class="pa-5">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudChip T="string" Size="MudBlazor.Size.Small" Variant="Variant.Filled"
                                             Style="background: rgba(5, 150, 105, 0.15); color: #6EE7B7; font-weight: 600; text-transform: uppercase; font-size: 0.7rem;">
                                        @package.PackageTypeName
                                    </MudChip>
                                    <MudText Typo="Typo.h6" Style="font-weight: 700; color: #6EE7B7;">
                                        @package.Price.ToString("C")
                                    </MudText>
                                </MudStack>
                                <MudText Typo="Typo.subtitle1" Class="mt-3" Style="font-weight: 600; color: #F1F5F9;">
                                    @package.Name
                                </MudText>
                                @if (!string.IsNullOrEmpty(package.Description))
                                {
                                    <MudText Typo="Typo.body2" Class="mt-1" Style="color: #CBD5E1;">
                                        @package.Description
                                    </MudText>
                                }
                                <MudDivider Class="my-3" Style="border-color: #1E3A2F;" />
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="MudBlazor.Size.Small" Style="color: #059669;" />
                                        <MudText Typo="Typo.body2" Style="color: #CBD5E1;">
                                            @package.PickUpStart.ToString("HH:mm") – @package.PickUpEnd.ToString("HH:mm")
                                        </MudText>
                                    </MudStack>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="MudBlazor.Size.Small"
                                                   Style="color: #6EE7B7;"
                                                   OnClick="() => NavigateToEditPackage(package.Id)" />
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudContainer>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [Inject]
    public required BusinessService businessService { get; set; }
    [Inject]
    public required PackageService packageService { get; set; }
    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    private BusinessDetailsModel? Business;
    private List<PackageGetModel>? Packages;

    protected override async Task OnInitializedAsync()
    {
        Business = await businessService.GetOneById(Id);
        Packages = await packageService.GetByBusinessId(Id);
    }

    public void NavigateToAddPackage()
    {
        NavigationManager.NavigateTo($"business/{Id}/addPackage");
    }

    public void NavigateToEditPackage(int packageId)
    {
        NavigationManager.NavigateTo($"business/{Id}/editPackage/{packageId}");
    }
}
