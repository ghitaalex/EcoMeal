@page "/not-found"
@layout MainLayout

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center" Style="min-height: 60vh; text-align: center;">
    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Style="font-size: 5rem; color: var(--accent); margin-bottom: 1rem;" />
    <MudText Typo="Typo.h4" Style="font-weight: 800; color: var(--accent-text);">Page Not Found</MudText>
    <MudText Typo="Typo.body1" Class="mt-2 mb-6" Style="color: var(--text-muted);">Sorry, the content you are looking for does not exist.</MudText>
    <MudButton Variant="Variant.Filled" Href="/"
               Style="background: var(--gradient-primary); color: #fff; text-transform: none; font-weight: 700; border-radius: 12px; box-shadow: var(--glow-sm);">
        Back to Home
    </MudButton>
</MudContainer>